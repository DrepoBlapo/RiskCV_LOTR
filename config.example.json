{
  "model": {
    "path": "./models/best.pt",
    "confidence": 0.30,
    "iou": 0.55,
    "imgsz": 1280,
    "device": "0",
    "half": true,
    "max_det": 300
  },
  "camera": {
    "index": 0,
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "backend": "dshow"
  },
  "assets": {
    "territory_id_map": "./prepared_assets/territory_id_map.png",
    "territories": "./prepared_assets/territories.json.gz",
    "map_texture": "./prepared_assets/map_texture.png",
    "map_marks": "./prepared_assets/map_texture_marcas.json"
  },
  "marks": {
    "type_to_color": {"marca_1": "marca_1", "marca_2": "marca_2"}
  },
  "conflict_resolution": {
    "strategy": "max_detection",
    "weights": {"max": 1.0, "mean": 0.5, "sum": 0.0, "count": 0.0},
    "zoom": {"enabled": true, "padding_fraction": 0.8, "confidence": 0.20, "merge": "replace"}
  },
  "calibration": {
    "file": "./app_data/calibration.json",
    "lookup_radius_px": 8,
    "contact_y_fraction": 0.92
  },
  "output": {
    "directory": "./phase_results"
  },
  "display": {
    "colors": {
      "negro": "#151413",
      "rojo": "#981A22",
      "amarillo": "#FAE81E",
      "verde": "#AFC839"
    }
  },
  "table": {
    "color_order": [
      "negro",
      "rojo",
      "amarillo",
      "verde"
    ],
    "columns": [
      {
        "key": "territories",
        "title": "Territorios",
        "format": "{:.0f}"
      }
    ]
  }
}
